ENVIRONMENT=DEVELOPMENT
LOG_LEVEL=INFO

EDGE_ROUTER_SERVICE_PORT=8080
EDGE_ROUTER_SERVICE_URL=http://edge-router:8080

FRONT_END_SERVICE_PORT=8081
FRONT_END_SERVICE_URL=http://front-end:8081

LOGISTICS_SERVICE_PORT=8082
LOGISTICS_SERVICE_URL=http://logistics:8082

WEATHER_SERVICE_PORT=8083
WEATHER_SERVICE_URL=http://weather:8083

CALCULATOR_SERVICE_PORT=8084
CALCULATOR_SERVICE_URL=http://calculator:8084

ML_SERVICE_PORT=8085
ML_SERVICE_URL=http://ml:8085

ML_MODEL_PATH=app/models/asphalt_model_calibrated.pkl
ML_API_PREFIX=/api/v1
YANDEX_WEATHER_API_KEY=b0ab4cbf-693d-4c1b-b8c2-6c9a9588f8ac

DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json
API_PREFIX=/api/v1

LOGISTICS_DB_HOST=postgres-logistics
LOGISTICS_DB_PORT=5432
LOGISTICS_DB_NAME=asphalt_logistics
LOGISTICS_DB_URL_TEMPLATE=postgresql+asyncpg://{user}:{password}@postgres-logistics:5432/{db_name}

WEATHER_DB_HOST=postgres-weather
WEATHER_DB_PORT=5432
WEATHER_DB_NAME=asphalt_weather
WEATHER_DB_URL_TEMPLATE=postgresql+asyncpg://{user}:{password}@postgres-weather:5432/{db_name}

REDIS_PORT=6379
REDIS_HOST=redis-cache
